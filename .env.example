# Claude (Anthropic) — used for AI script + prompt generation
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Kling AI — choose ONE of the two options below ──────────────────────────

# Option A: PiAPI (recommended — single key, easier to set up)
# Get your key at: https://piapi.ai
PIAPI_KEY=your_piapi_key_here

# Option B: Direct Kling API (access key + secret key pair)
# Get your keys at: https://klingai.com/developer
KLING_ACCESS_KEY=your_kling_access_key_here
KLING_SECRET_KEY=your_kling_secret_key_here
